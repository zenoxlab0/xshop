# ─────────────────────────────────────────────
#  X SHOP • Premium Digital Marketplace
# ─────────────────────────────────────────────

# Discord bot credentials (required)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Server configuration (required)
OWNER_ID=
SHOP_CHANNEL_ID=
STAFF_ROLE_ID=
ORDER_CATEGORY_ID=

# Log channels (optional — logs are skipped when empty)
ORDER_LOG_CHANNEL_ID=
PAYMENT_LOG_CHANNEL_ID=
STAFF_LOG_CHANNEL_ID=
ERROR_LOG_CHANNEL_ID=

# Social proof channels (optional — can also be set in-bot with
# !vouchchannel #channel / !dealchannel #channel; the in-bot setting wins)
VOUCH_CHANNEL_ID=
DEAL_CHANNEL_ID=

# Optional extra admin role (owner + Administrators are always admin)
ADMIN_ROLE_ID=

# Behaviour
PREFIX=!
BUY_TRIGGERS=buy,shop,purchase
CURRENCY=$

# Anti-spam
BUY_COOLDOWN_MS=10000
TICKET_COOLDOWN_MS=60000
PROOF_COOLDOWN_MS=15000
MAX_ACTIVE_ORDERS=3

# Web dashboard (change the password before exposing beyond localhost!)
WEB_DASHBOARD_PASSWORD=change-me
WEB_PORT=3000
WEB_HOST=0.0.0.0
